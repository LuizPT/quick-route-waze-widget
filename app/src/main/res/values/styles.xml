<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#33CCFF</item>
        <item name="android:statusBarColor">#0A0F15</item>
        <item name="android:navigationBarColor">#0A0F15</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0A0F15</item>
    </style>
    <style name="ProxyTheme" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>
    <style name="WidgetActionWide">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>
    <style name="WidgetActionIconWide">
        <item name="android:layout_width">23dp</item>
        <item name="android:layout_height">23dp</item>
        <item name="android:tint">@color/widget_accent</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="WidgetActionLabelWide">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
    </style>
    <style name="WidgetActionCompact">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>
    <style name="WidgetActionIconCompact">
        <item name="android:layout_width">21dp</item>
        <item name="android:layout_height">21dp</item>
        <item name="android:tint">@color/widget_accent</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="WidgetActionLabelCompact">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
    </style>
</resources>
