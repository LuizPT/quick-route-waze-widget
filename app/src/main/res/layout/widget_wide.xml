<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/widget_card">

    <LinearLayout
        android:id="@+id/action_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/action_home"
            style="@style/WidgetActionTile"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_tile">
            <ImageView
                android:id="@+id/icon_home"
                style="@style/WidgetActionTileIcon"
                android:src="@drawable/ic_home" />
            <TextView
                android:id="@+id/label_home"
                style="@style/WidgetActionTileLabel"
                android:text="@string/widget_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_work"
            style="@style/WidgetActionTile"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_tile">
            <ImageView
                android:id="@+id/icon_work"
                style="@style/WidgetActionTileIcon"
                android:src="@drawable/ic_work" />
            <TextView
                android:id="@+id/label_work"
                style="@style/WidgetActionTileLabel"
                android:text="@string/widget_work" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_open"
            style="@style/WidgetActionTile"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_tile">
            <ImageView
                android:id="@+id/icon_open"
                style="@style/WidgetActionTileIcon"
                android:src="@drawable/ic_open" />
            <TextView
                android:id="@+id/label_open"
                style="@style/WidgetActionTileLabel"
                android:text="@string/widget_open" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
